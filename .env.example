# Copy this file to ".env" (in this same directory) and adjust as needed:
#     cp .env.example .env
#
# This file is for LOCAL DEVELOPMENT with dev-docker-compose.yml. Every value has a
# working default, so .env is OPTIONAL locally. NEVER commit a real .env.
#
# PRODUCTION values go into the Render dashboard (Environment tab) for both the
# Web Service (backend secrets) and the Static Site (VITE_API_BASE).
# See DEPLOYMENT.md for the full runbook.

# --- Backend: database -----------------------------------------------------
# DEV: mongodb://mongo:27017 (no auth, local container).
# PROD (Atlas): a mongodb+srv:// connection string set in Render, not here.
MONGO_URI=mongodb://mongo:27017

# Logical database name inside MongoDB.
MONGO_DB_NAME=night_shift

# --- Backend: JWT tokens ---------------------------------------------------
# Two SEPARATE, strong secrets. Generate each with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_ACCESS_SECRET signs short-lived access JWTs.
# JWT_REFRESH_SECRET is the HMAC pepper used to hash refresh tokens before storage.
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me

# Access token lifetime in minutes (short — silently refreshed by the client).
ACCESS_EXPIRE_MINUTES=15

# Refresh token lifetime in days (rotated on every use; revocable server-side).
REFRESH_EXPIRE_DAYS=7

# --- Backend: CORS ----------------------------------------------------------
# JSON array of allowed browser origins. Dev defaults to http://localhost:5173.
# In production (Render), set this to your Vercel URL, e.g.:
#   CORS_ORIGINS=["https://night-shift.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (PUBLIC) -----------------------------------------------------
# Base URL the browser uses to reach the backend API. This is the ONLY variable
# that belongs on Vercel. It is PUBLIC (baked into the build) — never a secret.
#   DEV:  http://localhost:8000
#   PROD: https://your-backend.onrender.com  (set in the Render Static Site dashboard)
VITE_API_BASE=http://localhost:8000
