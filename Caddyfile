# Caddy reverse proxy — HTTPS/TLS termination for the backend API.
#
# NOTE: The recommended production path is Render + MongoDB Atlas (see DEPLOYMENT.md).
# This file is for self-hosted deployment where Caddy terminates TLS on your own VM.
#
# Caddy automatically obtains and renews a Let's Encrypt certificate for
# {$API_DOMAIN} and serves everything over HTTPS, redirecting HTTP→HTTPS for you.
# It then proxies requests to the backend container on the private `web` network.
# The domain and ACME contact email are injected from the environment by compose.

{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# Forward all traffic to the backend service (Docker DNS resolves "backend").
	reverse_proxy backend:8000

	# Security headers applied to every response.
	header {
		# HSTS: force HTTPS for a year, including subdomains. Only enable once you're
		# confident the domain is HTTPS-only — it's hard to walk back.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Don't let the browser second-guess declared content types.
		X-Content-Type-Options "nosniff"
		# Disallow being framed (clickjacking protection).
		X-Frame-Options "DENY"
		# Don't leak the full referring URL to other origins.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the server-identifying header.
		-Server
	}

	# Compress responses where the client supports it.
	encode gzip zstd
}
